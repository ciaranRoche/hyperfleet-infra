# OCI proof-of-concept environment: HyperFleet on the OKE management cluster
# built by terraform/oci-poc, driving HyperShift on the same cluster.
# Released images for the API and sentinel. The adapter runs a main build,
# pinned by its commit tag (digest sha256:2607d080...), because its latest release (0.3.1) predates the v2 task
# configuration format the adapters under helmfile/configs/oci use.
RABBITMQ_URL ?= "amqp://guest:guest@rabbitmq:5672"
GATEWAY_SERVICE_TYPE ?= ClusterIP
API_BASE_URL ?= http://hyperfleet-gateway:8000

REGISTRY ?= quay.io
API_REPOSITORY ?= redhat-services-prod/hyperfleet-tenant/hyperfleet/hyperfleet-api
SENTINEL_REPOSITORY ?= redhat-services-prod/hyperfleet-tenant/hyperfleet/hyperfleet-sentinel
ADAPTER_REPOSITORY ?= redhat-services-prod/hyperfleet-tenant/hyperfleet/hyperfleet-adapter
APPLIER_REPOSITORY ?= redhat-services-prod/hyperfleet-tenant/hyperfleet/hyperfleet-applier

CHART_ORG ?= openshift-hyperfleet
API_CHART_REF ?= main
SENTINEL_CHART_REF ?= main
ADAPTER_CHART_REF ?= main
APPLIER_CHART_REF ?= main

API_IMAGE_TAG ?= 0.4.1
SENTINEL_IMAGE_TAG ?= 0.3.1
ADAPTER_IMAGE_TAG ?= 9e46780e166bbc20d6ac4f8a89c53ce49804fe58
APPLIER_IMAGE_TAG ?= 0.1.0-rc1
IMAGE_PULL_POLICY ?= IfNotPresent

# Sentinel 0.3.1 cannot render an auth scheme; tenancy is out of scope here.
AUTH_MODE ?= NONE
OIDC_ISSUER_URL ?=
OIDC_JWKS_URL ?=
TENANT_ISOLATION_ENABLED ?= false
TENANT_MODEL ?= oracle
AUTHORINO_LOG_LEVEL ?= info
ENVOY_LOG_LEVEL ?= info

NAMESPACE ?= hyperfleet
BUILD_IMAGES ?= false
OBSERVABILITY_ENABLED ?= false
MONITORING_NAMESPACE ?= monitoring
TRACING_ENABLED ?= false
